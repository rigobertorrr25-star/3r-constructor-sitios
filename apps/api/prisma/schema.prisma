// Esquema de base de datos del constructor de sitios (PostgreSQL).
// Los estados se guardan como VARCHAR (según el diseño) y se validan en código.
// Convención: campos camelCase en Prisma, columnas snake_case en la base.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── USUARIOS ─────────────────────────

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash")
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  avatarUrl         String?   @map("avatar_url")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  // Cuándo aceptó la política de tratamiento de datos (prueba de la autorización, Ley 1581).
  privacyAcceptedAt DateTime? @map("privacy_accepted_at") @db.Timestamptz(6)
  // active | suspended | deleted
  status            String    @default("active") @db.VarChar(30)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles              UserRole[]
  sessions           UserSession[]
  memberships        CompanyMember[]
  sites              Site[]
  pageVersions       PageVersion[]
  assets             Asset[]
  subscriptions      Subscription[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
  verificationTokens VerificationToken[]
  tickets            SupportTicket[]     @relation("TicketRequester")
  assignedTickets    SupportTicket[]     @relation("TicketAssignee")
  orders             Order[]
  orderEvents        OrderEvent[]

  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  // USER | ADMIN | SUPER_ADMIN (más adelante AGENCY, EDITOR, SUPPORT, BILLING)
  role   String @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  // Solo se guarda el hash del refresh token, nunca el token en claro.
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_sessions_user_id")
  @@index([refreshTokenHash], map: "idx_user_sessions_token_hash")
  @@map("user_sessions")
}

// ───────────────────────── SITIOS ─────────────────────────

model Site {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  name               String   @db.VarChar(150)
  slug               String   @db.VarChar(150)
  description        String?
  // draft | published | archived
  status             String   @default("draft") @db.VarChar(30)
  templateId         String?  @map("template_id") @db.Uuid
  publishedVersionId String?  @map("published_version_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template         Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  publishedVersion PageVersion?     @relation("SitePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  pages            Page[]
  assets           Asset[]
  domains          Domain[]
  publications     Publication[]
  deploymentJobs   DeploymentJob[]
  tickets          SupportTicket[]
  order            Order?
  formSubmissions  FormSubmission[]

  @@unique([userId, slug])
  @@index([userId], map: "idx_sites_user_id")
  @@map("sites")
}

model Page {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  title          String   @db.VarChar(150)
  slug           String   @db.VarChar(150)
  pageType       String?  @default("standard") @map("page_type") @db.VarChar(30)
  sortOrder      Int      @default(0) @map("sort_order")
  isHomepage     Boolean  @default(false) @map("is_homepage")
  isPublished    Boolean  @default(false) @map("is_published")
  seoTitle       String?  @map("seo_title") @db.VarChar(255)
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  versions PageVersion[]

  @@unique([siteId, slug])
  @@index([siteId], map: "idx_pages_site_id")
  @@map("pages")
}

model PageVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId        String   @map("page_id") @db.Uuid
  versionNumber Int      @map("version_number")
  // Documento completo del editor (árbol JSON versionado)
  content       Json
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  page              Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author            User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  publications      Publication[]
  publishedForSites Site[]        @relation("SitePublishedVersion")

  @@unique([pageId, versionNumber])
  @@index([pageId], map: "idx_page_versions_page_id")
  @@map("page_versions")
}

// Componentes reutilizables del editor (bloques guardados).
// Tabla listada en el diseño ("components") sin columnas definidas: se propone esta estructura.
model Component {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  type      String   @db.VarChar(50)
  category  String?  @db.VarChar(100)
  content   Json
  isSystem  Boolean  @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([type], map: "idx_components_type")
  @@map("components")
}

model Template {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(150)
  slug         String   @unique @db.VarChar(150)
  category     String?  @db.VarChar(100)
  thumbnailUrl String?  @map("thumbnail_url")
  content      Json
  isPremium    Boolean  @default(false) @map("is_premium")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sites Site[]

  @@map("templates")
}

// ───────────────────────── DOMINIOS ─────────────────────────

model Domain {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId              String    @map("site_id") @db.Uuid
  domain              String    @unique @db.VarChar(255)
  // subdomain | custom
  type                String    @default("custom") @db.VarChar(30)
  // pending | verified | failed
  verificationStatus  String    @default("pending") @map("verification_status") @db.VarChar(30)
  // pending | active | failed
  sslStatus           String    @default("pending") @map("ssl_status") @db.VarChar(30)
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(6)
  // Solo dominios propios: hasta cuándo está pagado (se renueva cada año) y cuándo se avisó al cliente
  // que se vence. Renovar vuelve a dejar el aviso en null.
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  renewalNoticeSentAt DateTime? @map("renewal_notice_sent_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId], map: "idx_domains_site_id")
  @@index([expiresAt], map: "idx_domains_expires_at")
  @@map("domains")
}

// ───────────────────────── MULTIMEDIA ─────────────────────────

model Asset {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId     String   @map("site_id") @db.Uuid
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  filename   String   @db.VarChar(255)
  // Clave del objeto en S3 / Cloudflare R2. El archivo NO vive en PostgreSQL.
  storageKey String   @map("storage_key")
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  fileSize   BigInt?  @map("file_size")
  width      Int?
  height     Int?
  altText    String?  @map("alt_text")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  site     Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([siteId], map: "idx_assets_site_id")
  @@map("assets")
}

// ───────────────────────── PUBLICACIÓN ─────────────────────────

model Publication {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId        String    @map("site_id") @db.Uuid
  versionId     String    @map("version_id") @db.Uuid
  // queued | building | published | failed
  status        String    @default("queued") @db.VarChar(30)
  deploymentUrl String?   @map("deployment_url")
  storagePath   String?   @map("storage_path")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  site    Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  version PageVersion     @relation(fields: [versionId], references: [id])
  jobs    DeploymentJob[]

  @@index([siteId], map: "idx_publications_site_id")
  @@map("publications")
}

// Trabajo de despliegue que ejecuta un worker (BullMQ) para una publicación.
// Tabla listada en el diseño sin columnas definidas: se propone esta estructura.
model DeploymentJob {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicationId String    @map("publication_id") @db.Uuid
  siteId        String    @map("site_id") @db.Uuid
  // queued | running | succeeded | failed
  status        String    @default("queued") @db.VarChar(30)
  attempts      Int       @default(0)
  queueJobId    String?   @map("queue_job_id") @db.VarChar(255)
  errorMessage  String?   @map("error_message")
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  site        Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([publicationId], map: "idx_deployment_jobs_publication_id")
  @@index([status], map: "idx_deployment_jobs_status")
  @@map("deployment_jobs")
}

// ───────────────────────── FACTURACIÓN ─────────────────────────

model Plan {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @unique @db.VarChar(100)
  stripeProductId String?  @map("stripe_product_id") @db.VarChar(255)
  stripePriceId   String?  @map("stripe_price_id") @db.VarChar(255)
  priceCents      Int      @map("price_cents")
  currency        String   @default("USD") @db.VarChar(10)
  maxSites        Int?     @map("max_sites")
  maxPages        Int?     @map("max_pages")
  maxStorageMb    Int?     @map("max_storage_mb")
  customDomains   Boolean? @default(false) @map("custom_domains")
  analytics       Boolean? @default(false)
  whiteLabel      Boolean? @default(false) @map("white_label")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  planId               String    @map("plan_id") @db.Uuid
  stripeCustomerId     String    @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String    @unique @map("stripe_subscription_id") @db.VarChar(255)
  status               String    @db.VarChar(50)
  currentPeriodStart   DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([userId], map: "idx_subscriptions_user_id")
  @@index([status], map: "idx_subscriptions_status")
  @@map("subscriptions")
}

model Invoice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  subscriptionId  String?   @map("subscription_id") @db.Uuid
  stripeInvoiceId String    @unique @map("stripe_invoice_id") @db.VarChar(255)
  amountCents     Int       @map("amount_cents")
  currency        String    @db.VarChar(10)
  status          String    @db.VarChar(50)
  invoiceUrl      String?   @map("invoice_url")
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
}

// Idempotencia de webhooks: el par (provider, event_id) es único.
model WebhookEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String    @db.VarChar(50)
  eventId      String    @map("event_id") @db.VarChar(255)
  eventType    String    @map("event_type") @db.VarChar(255)
  payload      Json
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(6)
  failedAt     DateTime? @map("failed_at") @db.Timestamptz(6)
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([eventType], map: "idx_webhook_events_type")
  @@map("webhook_events")
}

// Enlaces de un solo uso que se mandan por correo: verificar el email y recuperar la contraseña.
model VerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Solo se guarda el hash del token, igual que el refresh token.
  tokenHash String    @map("token_hash")
  // email_verification | password_reset
  purpose   String    @db.VarChar(30)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([tokenHash])
  @@map("verification_tokens")
}

// ───────────────────────── VENTAS ─────────────────────────
// El cliente compra una página web hecha por nosotros: elige un paquete, describe su negocio
// (brief), paga por fuera y sigue el estado de su pedido.

model Package {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @db.VarChar(100)
  slug              String   @unique @db.VarChar(100)
  tagline           String?  @db.VarChar(200)
  description       String?
  // Pago único por la página, en centavos.
  priceCents        Int      @map("price_cents")
  // Mensualidad opcional de hosting y mantenimiento, en centavos.
  monthlyPriceCents Int?     @map("monthly_price_cents")
  currency          String   @default("USD") @db.VarChar(10)
  // Lista de textos (["Diseño a medida", ...]).
  features          Json     @default("[]")
  pagesIncluded     Int      @default(1) @map("pages_included")
  deliveryDays      Int?     @map("delivery_days")
  isFeatured        Boolean  @default(false) @map("is_featured")
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders Order[]

  @@map("packages")
}

model Order {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Número corto para mostrar y para que el cliente lo mencione (3R-0001).
  orderNumber       Int       @unique @default(autoincrement()) @map("order_number")
  userId            String    @map("user_id") @db.Uuid
  packageId         String    @map("package_id") @db.Uuid
  // new | awaiting_payment | in_progress | in_review | delivered | cancelled
  status            String    @default("new") @db.VarChar(30)
  // unpaid | partial | paid | refunded
  paymentStatus     String    @default("unpaid") @map("payment_status") @db.VarChar(30)
  // Precios al momento de comprar: cambiar el paquete después no altera pedidos existentes.
  // priceCents es el total del pago único: paquete + extras (como el dominio propio).
  priceCents        Int       @map("price_cents")
  // Parte de priceCents que corresponde al dominio propio; null si el cliente no lo pidió.
  domainPriceCents  Int?      @map("domain_price_cents")
  monthlyPriceCents Int?      @map("monthly_price_cents")
  currency          String    @db.VarChar(10)
  amountPaidCents   Int       @default(0) @map("amount_paid_cents")
  // Datos del negocio que el cliente llena al pedir.
  brief             Json
  // Sitio que se construye para este pedido (vive en la cuenta del administrador).
  siteId            String?   @unique @map("site_id") @db.Uuid
  deliveryUrl       String?   @map("delivery_url")
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id])
  package  Package      @relation(fields: [packageId], references: [id])
  site     Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  events   OrderEvent[]
  payments Payment[]

  @@index([userId], map: "idx_orders_user_id")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

// Intentos de pago en línea (Wompi). Cada intento tiene su propia referencia; solo los aprobados suman
// a Order.amountPaidCents, y un mismo pago nunca se cuenta dos veces.
model Payment {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String   @map("order_id") @db.Uuid
  provider              String   @default("wompi") @db.VarChar(20)
  // Referencia que se le manda a Wompi (3R-0012-a1b2c3d4).
  reference             String   @unique @db.VarChar(100)
  amountCents           Int      @map("amount_cents")
  currency              String   @db.VarChar(10)
  // pending | approved | declined | voided | error
  status                String   @default("pending") @db.VarChar(20)
  providerTransactionId String?  @unique @map("provider_transaction_id") @db.VarChar(100)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_payments_order_id")
  @@map("payments")
}

// Historial del pedido: cambios de estado, pagos, mensajes y notas internas.
model OrderEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  actorId         String?  @map("actor_id") @db.Uuid
  // status | payment | message | note | delivery
  kind            String   @db.VarChar(30)
  body            String?
  metadata        Json?
  // Las notas internas no las ve el cliente.
  visibleToClient Boolean  @default(true) @map("visible_to_client")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "idx_order_events_order_id")
  @@map("order_events")
}

// Trabajos ya hechos que se muestran en la portada como ejemplos.
model PortfolioItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String   @db.VarChar(120)
  // Enlace a la página publicada.
  url          String   @db.VarChar(500)
  category     String?  @db.VarChar(80)
  description  String?  @db.VarChar(300)
  // Captura de la página (ruta propia o https).
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("portfolio_items")
}

// Mensajes del formulario de contacto de una página publicada (visitante → dueño del sitio).
model FormSubmission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  message   String   @db.VarChar(4000)
  // new | contacted | quoted | won | lost — el embudo del cliente sobre sus propios mensajes.
  status    String   @default("new") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("form_submissions")
}

// ───────────────────────── ADMINISTRACIÓN ─────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

// Tickets de soporte. Tabla listada en el diseño sin columnas definidas: se propone esta estructura.
model SupportTicket {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  siteId      String?   @map("site_id") @db.Uuid
  assignedTo  String?   @map("assigned_to") @db.Uuid
  subject     String    @db.VarChar(255)
  description String
  // open | pending | resolved | closed
  status      String    @default("open") @db.VarChar(30)
  // low | normal | high | urgent
  priority    String    @default("normal") @db.VarChar(30)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User  @relation("TicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignee User? @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  site     Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_support_tickets_user_id")
  @@index([status], map: "idx_support_tickets_status")
  @@map("support_tickets")
}

// ───────────────────────── PLATAFORMA EMPRESARIAL ─────────────────────────
// Cada empresa cliente tiene miembros con un rol y activa los módulos que contrata (CRM, tickets, empleados…).

model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(150)
  // NIT o cédula del responsable, opcional.
  taxId     String?  @map("tax_id") @db.VarChar(30)
  city      String?  @db.VarChar(100)
  phone     String?  @db.VarChar(50)
  industry  String?  @db.VarChar(60)
  // active | suspended (suspendida: nadie entra, los datos se conservan)
  status    String   @default("active") @db.VarChar(20)
  // Último número de ticket usado (los tickets se numeran por empresa: #1, #2…).
  ticketSeq Int      @default(0) @map("ticket_seq")
  // Último número de cotización usado (COT-1, COT-2…).
  quoteSeq  Int      @default(0) @map("quote_seq")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members          CompanyMember[]
  modules          CompanyModule[]
  invites          CompanyInvite[]
  crmContacts      CrmContact[]
  crmActivities    CrmActivity[]
  tickets          Ticket[]
  ticketEvents     TicketEvent[]
  employeeProfiles EmployeeProfile[]
  leaveRequests    LeaveRequest[]
  announcements    Announcement[]
  documents        CompanyDocument[]
  calendarEvents   CalendarEvent[]
  notifications    Notification[]
  quotes           Quote[]
  subscription     CompanySubscription?
  invoices         CompanyInvoice[]
  surveys          Survey[]
  courses          Course[]

  @@map("companies")
}

model CompanyMember {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // owner | admin | hr | supervisor | employee (ver companies.constants.ts)
  role      String    @db.VarChar(20)
  jobTitle  String?   @map("job_title") @db.VarChar(120)
  area      String?   @db.VarChar(120)
  hiredAt   DateTime? @map("hired_at") @db.Date
  // active | disabled (deshabilitado: no entra, pero queda su historial)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile           EmployeeProfile?
  leaveRequests     LeaveRequest[]
  courseProgress    CourseProgress[]
  announcementReads AnnouncementRead[]
  documents         CompanyDocument[]
  notifications     Notification[]

  @@unique([companyId, userId])
  @@index([userId], map: "idx_company_members_user_id")
  @@map("company_members")
}

// Módulo activo en una empresa. Sin fila = no lo tiene.
model CompanyModule {
  companyId String   @map("company_id") @db.Uuid
  // crm | tickets | employees | … (ver MODULES en companies.constants.ts)
  key       String   @db.VarChar(40)
  enabledAt DateTime @default(now()) @map("enabled_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, key])
  @@map("company_modules")
}

model CompanyInvite {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  email      String    @db.VarChar(255)
  role       String    @db.VarChar(20)
  // Solo el hash del token que va en el enlace del correo.
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "idx_company_invites_company_id")
  @@map("company_invites")
}

// ───────────────────────── MÓDULO: CRM ─────────────────────────

model CrmContact {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  name          String    @db.VarChar(150)
  // Empresa o negocio del contacto (si es un cliente empresarial).
  organization  String?   @db.VarChar(150)
  email         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  // lead | contacted | quote | negotiation | won | lost (ver crm.constants.ts)
  stage         String    @default("lead") @db.VarChar(20)
  // Valor potencial del negocio, en centavos de COP.
  valueCents    BigInt?   @map("value_cents")
  // manual | web | whatsapp | referral | social | other
  source        String    @default("manual") @db.VarChar(20)
  notes         String?   @db.VarChar(4000)
  // Responsable dentro de la empresa (miembro). Si sale de la empresa, queda sin responsable.
  ownerMemberId String?   @map("owner_member_id") @db.Uuid
  lastContactAt DateTime? @map("last_contact_at") @db.Timestamptz(6)
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activities CrmActivity[]
  quotes     Quote[]

  @@index([companyId, stage], map: "idx_crm_contacts_company_stage")
  @@map("crm_contacts")
}

model CrmActivity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  // Quién la registró (usuario). Null si ya no existe.
  userId    String?  @map("user_id") @db.Uuid
  // note | call | email | whatsapp | meeting | stage (cambio de etapa, automático)
  kind      String   @db.VarChar(20)
  body      String   @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt], map: "idx_crm_activities_contact")
  @@map("crm_activities")
}

// ───────────────────────── MÓDULO: TICKETS ─────────────────────────

model Ticket {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  // Número visible dentro de la empresa (#1, #2…).
  number            Int
  title             String    @db.VarChar(150)
  description       String    @db.VarChar(8000)
  // support | hr | maintenance | admin | accounting | purchases | other (ver tickets.constants.ts)
  category          String    @db.VarChar(20)
  // low | medium | high | urgent
  priority          String    @default("medium") @db.VarChar(10)
  // open | assigned | in_progress | resolved | closed
  status            String    @default("open") @db.VarChar(20)
  // Quién lo pidió y quién lo atiende (miembros). Si salen de la empresa, quedan en null.
  requesterMemberId String?   @map("requester_member_id") @db.Uuid
  assigneeMemberId  String?   @map("assignee_member_id") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  TicketEvent[]

  @@unique([companyId, number])
  @@index([companyId, status], map: "idx_tickets_company_status")
  @@map("tickets")
}

// Historial del ticket: comentarios y cambios (estado, responsable, prioridad), en orden.
model TicketEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  // Quién lo hizo (usuario). Null si ya no existe.
  userId    String?  @map("user_id") @db.Uuid
  // comment | status | assign | priority
  kind      String   @db.VarChar(20)
  body      String   @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt], map: "idx_ticket_events_ticket")
  @@map("ticket_events")
}

// ───────────────────────── MÓDULO: PORTAL DEL EMPLEADO ─────────────────────────

// Ficha de un miembro de la empresa. Datos personales (los llena el empleado o RR. HH.) y laborales (solo RR. HH.).
// Cargo, área y fecha de ingreso viven en company_members.
model EmployeeProfile {
  memberId          String    @id @map("member_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  // CC | CE | PPT | PA | TI
  documentType      String?   @map("document_type") @db.VarChar(5)
  documentNumber    String?   @map("document_number") @db.VarChar(30)
  phone             String?   @db.VarChar(50)
  // Si el empleado deja ver su teléfono en el directorio del equipo.
  showPhone         Boolean   @default(false) @map("show_phone")
  birthDate         DateTime? @map("birth_date") @db.Date
  address           String?   @db.VarChar(200)
  city              String?   @db.VarChar(100)
  emergencyName     String?   @map("emergency_name") @db.VarChar(150)
  emergencyPhone    String?   @map("emergency_phone") @db.VarChar(50)
  emergencyRelation String?   @map("emergency_relation") @db.VarChar(60)
  eps               String?   @db.VarChar(100)
  pensionFund       String?   @map("pension_fund") @db.VarChar(100)
  // indefinite | fixed | project | services | apprentice
  contractType      String?   @map("contract_type") @db.VarChar(20)
  contractEnd       DateTime? @map("contract_end") @db.Date
  // Salario mensual en pesos (sin centavos).
  salary            Int?
  schedule          String?   @db.VarChar(150)
  // Notas internas de RR. HH. (el empleado no las ve).
  hrNotes           String?   @map("hr_notes") @db.VarChar(4000)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  member  CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "idx_employee_profiles_company")
  @@map("employee_profiles")
}

// ───────────────────────── MÓDULO: PERMISOS Y VACACIONES ─────────────────────────

// Solicitud de un empleado: vacaciones, permiso, incapacidad, certificado u otra.
// Flujo: pending (espera al supervisor) → supervisor_ok (espera a RR. HH.) → approved; o rejected / cancelled.
model LeaveRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  // Quien pide (miembro). Si sale de la empresa, la solicitud se borra con su ficha.
  memberId       String    @map("member_id") @db.Uuid
  // vacation | permission | sick_leave | certificate | other (ver requests.constants.ts)
  type           String    @db.VarChar(20)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  // Días sin contar domingos, calculados al crear.
  days           Int       @default(0)
  reason         String    @db.VarChar(2000)
  status         String    @default("pending") @db.VarChar(20)
  supervisorById String?   @map("supervisor_by_id") @db.Uuid
  supervisorAt   DateTime? @map("supervisor_at") @db.Timestamptz(6)
  supervisorNote String?   @map("supervisor_note") @db.VarChar(1000)
  hrById         String?   @map("hr_by_id") @db.Uuid
  hrAt           DateTime? @map("hr_at") @db.Timestamptz(6)
  hrNote         String?   @map("hr_note") @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member  CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([companyId, status], map: "idx_leave_requests_company_status")
  @@index([memberId], map: "idx_leave_requests_member")
  @@map("leave_requests")
}

// ───────────────────────── MÓDULO: COMUNICADOS ─────────────────────────

model Announcement {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  // news | notice | event (ver announcements.constants.ts)
  kind       String    @default("news") @db.VarChar(20)
  title      String    @db.VarChar(150)
  body       String    @db.VarChar(10000)
  // Para eventos: cuándo es.
  eventAt    DateTime? @map("event_at") @db.Timestamptz(6)
  eventPlace String?   @map("event_place") @db.VarChar(150)
  // Fijado arriba de la lista.
  pinned     Boolean   @default(false)
  authorId   String?   @map("author_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reads   AnnouncementRead[]

  @@index([companyId, createdAt], map: "idx_announcements_company")
  @@map("announcements")
}

// Quién leyó cada comunicado (una fila por persona).
model AnnouncementRead {
  announcementId String   @map("announcement_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  announcement Announcement  @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  member       CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([announcementId, memberId])
  @@index([memberId], map: "idx_announcement_reads_member")
  @@map("announcement_reads")
}

// ───────────────────────── MÓDULO: DOCUMENTOS ─────────────────────────

// Archivo privado de la empresa (políticas, manuales) o de un empleado (contrato, cédula, soportes).
model CompanyDocument {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  // Null: documento de la empresa. Con valor: documento de ese empleado (se borra si sale de la empresa).
  memberId     String?   @map("member_id") @db.Uuid
  // contract | id | certificate | payroll | medical | resume | policy | manual | other (ver documents.constants.ts)
  category     String    @db.VarChar(20)
  title        String    @db.VarChar(150)
  fileName     String    @map("file_name") @db.VarChar(200)
  contentType  String    @map("content_type") @db.VarChar(100)
  size         Int       @default(0)
  // Clave en el almacenamiento privado (nunca pública).
  storageKey   String    @unique @map("storage_key") @db.VarChar(120)
  // pending (pedido el enlace, falta subir) | ready
  status       String    @default("pending") @db.VarChar(10)
  // De la empresa: all (todo el equipo) | hr (solo RR. HH. en adelante). Del empleado: él y RR. HH.
  audience     String    @default("all") @db.VarChar(10)
  // Vencimiento (licencia, contrato, certificado), para avisos.
  expiresOn    DateTime? @map("expires_on") @db.Date
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member  CompanyMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([companyId, memberId], map: "idx_company_documents_company_member")
  @@map("company_documents")
}

// ───────────────────────── MÓDULO: CALENDARIO ─────────────────────────

// Reunión, evento o recordatorio. Los de la empresa (`personal` = false) los ve todo el equipo; un recordatorio
// personal solo quien lo creó. Vacaciones, cumpleaños y vencimientos no se guardan aquí: salen de sus módulos.
model CalendarEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  // meeting | event | reminder | deadline
  kind        String    @default("meeting") @db.VarChar(20)
  title       String    @db.VarChar(150)
  description String?   @db.VarChar(2000)
  location    String?   @db.VarChar(150)
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  allDay      Boolean   @default(false) @map("all_day")
  personal    Boolean   @default(false)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, startsAt], map: "idx_calendar_events_company_start")
  @@map("calendar_events")
}

// ───────────────────────── MÓDULO: ALERTAS ─────────────────────────

// Aviso para una persona de la empresa (campanita). Los manda cada módulo y la revisión diaria (vencimientos,
// cumpleaños, solicitudes sin responder). `dedupeKey` evita repetir el mismo aviso.
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  memberId  String    @map("member_id") @db.Uuid
  // ticket | request | announcement | document | contract | birthday | reminder
  kind      String    @db.VarChar(20)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  // Ruta dentro de /empresa/[id].
  href      String?   @db.VarChar(200)
  dedupeKey String?   @map("dedupe_key") @db.VarChar(120)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  // Ya salió en el resumen diario por correo.
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member  CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, dedupeKey])
  @@index([memberId, createdAt], map: "idx_notifications_member")
  @@map("notifications")
}

// ───────────────────────── MÓDULO: COTIZACIONES ─────────────────────────

// Cotización para un cliente. Se manda con un enlace (token) donde el cliente la acepta, la rechaza o pide cambios.
model Quote {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  number          Int
  // Cliente del CRM (opcional). Si se borra del CRM, la cotización queda con los datos copiados.
  contactId       String?   @map("contact_id") @db.Uuid
  clientName      String    @map("client_name") @db.VarChar(150)
  clientCompany   String?   @map("client_company") @db.VarChar(150)
  clientEmail     String?   @map("client_email") @db.VarChar(255)
  clientPhone     String?   @map("client_phone") @db.VarChar(50)
  title           String    @db.VarChar(150)
  notes           String?   @db.VarChar(4000)
  // Valores en pesos (sin centavos).
  discount        BigInt    @default(0)
  // Porcentaje de IVA: 0, 5 o 19.
  taxRate         Int       @default(0) @map("tax_rate")
  subtotal        BigInt    @default(0)
  tax             BigInt    @default(0)
  total           BigInt    @default(0)
  validUntil      DateTime? @map("valid_until") @db.Date
  // draft | sent | accepted | rejected | changes_requested
  status          String    @default("draft") @db.VarChar(20)
  // Solo el hash del token del enlace público.
  tokenHash       String?   @unique @map("token_hash") @db.VarChar(64)
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(6)
  viewedAt        DateTime? @map("viewed_at") @db.Timestamptz(6)
  respondedAt     DateTime? @map("responded_at") @db.Timestamptz(6)
  responseName    String?   @map("response_name") @db.VarChar(150)
  responseMessage String?   @map("response_message") @db.VarChar(2000)
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items   QuoteItem[]

  @@unique([companyId, number])
  @@index([companyId, status], map: "idx_quotes_company_status")
  @@map("quotes")
}

model QuoteItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId     String @map("quote_id") @db.Uuid
  position    Int
  description String @db.VarChar(300)
  quantity    Int
  // Pesos por unidad.
  unitPrice   BigInt @map("unit_price")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId], map: "idx_quote_items_quote")
  @@map("quote_items")
}

// ───────────────────────── SUSCRIPCIONES (cobro de la plataforma) ─────────────────────────

// Precio mensual de cada módulo, en pesos. Lo pone el equipo de 3R en /admin. Sin fila: precio por definir.
model ModulePrice {
  key          String   @id @db.VarChar(40)
  monthlyPrice Int      @map("monthly_price")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("module_prices")
}

// Plan de una empresa: se cobra cada mes lo de los módulos activos.
model CompanySubscription {
  companyId   String    @id @map("company_id") @db.Uuid
  // trial | active | past_due | cancelled
  status      String    @default("trial") @db.VarChar(20)
  trialEndsAt DateTime? @map("trial_ends_at") @db.Date
  // Día del mes en que se genera la factura (1 a 28).
  billingDay  Int       @default(1) @map("billing_day")
  notes       String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_subscriptions")
}

// Factura mensual de la plataforma (FAC-1, FAC-2…).
model CompanyInvoice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number      Int       @unique @default(autoincrement())
  companyId   String    @map("company_id") @db.Uuid
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  // [{ key, name, price }] en el momento de facturar.
  items       Json
  total       Int
  dueDate     DateTime  @map("due_date") @db.Date
  // pending | paid | void
  status      String    @default("pending") @db.VarChar(10)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  // transfer | wompi | other
  method      String?   @db.VarChar(20)
  paymentNote String?   @map("payment_note") @db.VarChar(300)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments InvoicePayment[]

  @@unique([companyId, periodStart])
  @@index([companyId, status], map: "idx_company_invoices_company_status")
  @@map("company_invoices")
}

// Intento de pago con Wompi de una factura (como `payments` para los pedidos).
model InvoicePayment {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId             String   @map("invoice_id") @db.Uuid
  reference             String   @unique @db.VarChar(100)
  amountCents           Int      @map("amount_cents")
  currency              String   @default("COP") @db.VarChar(10)
  status                String   @default("pending") @db.VarChar(20)
  providerTransactionId String?  @unique @map("provider_transaction_id") @db.VarChar(100)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice CompanyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "idx_invoice_payments_invoice")
  @@map("invoice_payments")
}

// ───────────────────────── MÓDULO: ENCUESTAS ─────────────────────────

// Encuesta del equipo (clima laboral; puede ser anónima) o para clientes (enlace público).
model Survey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  title       String    @db.VarChar(150)
  description String?   @db.VarChar(2000)
  // team | public
  audience    String    @db.VarChar(10)
  // Del equipo: no se guarda quién respondió.
  anonymous   Boolean   @default(false)
  // draft | open | closed
  status      String    @default("draft") @db.VarChar(10)
  closesAt    DateTime? @map("closes_at") @db.Timestamptz(6)
  // Para las de clientes: el enlace /encuesta/[token].
  publicToken String?   @unique @map("public_token") @db.VarChar(64)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([companyId, status], map: "idx_surveys_company_status")
  @@map("surveys")
}

model SurveyQuestion {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId String  @map("survey_id") @db.Uuid
  position Int
  // rating (1 a 5) | nps (0 a 10) | choice (una) | multi (varias) | text
  kind     String  @db.VarChar(10)
  text     String  @db.VarChar(300)
  // Opciones de choice/multi.
  options  Json?
  required Boolean @default(true)

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId], map: "idx_survey_questions_survey")
  @@map("survey_questions")
}

model SurveyResponse {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId      String   @map("survey_id") @db.Uuid
  // Solo si la encuesta del equipo no es anónima.
  memberId      String?  @map("member_id") @db.Uuid
  // Del equipo: hash de encuesta + persona, para que nadie responda dos veces (aunque sea anónima).
  respondentKey String?  @map("respondent_key") @db.VarChar(64)
  // De clientes: nombre si lo quiso dejar.
  name          String?  @db.VarChar(150)
  // { [questionId]: number | string | string[] }
  answers       Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, respondentKey])
  @@index([surveyId, createdAt], map: "idx_survey_responses_survey")
  @@map("survey_responses")
}

// ───────── Capacitaciones ─────────

model Course {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  title       String    @db.VarChar(150)
  description String?   @db.VarChar(2000)
  // draft | published | archived
  status      String    @default("draft") @db.VarChar(10)
  // Obligatorio: le sale como pendiente a todo el equipo.
  required    Boolean   @default(false)
  dueAt       DateTime? @map("due_at") @db.Date
  // Porcentaje mínimo para aprobar el quiz.
  passScore   Int       @default(70) @map("pass_score")
  createdById String?   @map("created_by_id") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lessons   CourseLesson[]
  questions CourseQuestion[]
  progress  CourseProgress[]

  @@index([companyId, status], map: "idx_courses_company_status")
  @@map("courses")
}

model CourseLesson {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String  @map("course_id") @db.Uuid
  position Int
  title    String  @db.VarChar(150)
  body     String  @db.Text
  // Enlace a un video (YouTube, Vimeo, Drive…) o material de apoyo.
  videoUrl String? @map("video_url") @db.VarChar(500)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "idx_course_lessons_course")
  @@map("course_lessons")
}

model CourseQuestion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  position Int
  text     String @db.VarChar(300)
  options  Json
  // Índice de la opción correcta (nunca se manda a quien toma el curso).
  correct  Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "idx_course_questions_course")
  @@map("course_questions")
}

// Avance de una persona en un curso.
model CourseProgress {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  memberId      String    @map("member_id") @db.Uuid
  // Ids de las lecciones vistas.
  lessonsDone   Json      @default("[]") @map("lessons_done")
  attempts      Int       @default(0)
  // Mejor puntaje del quiz (0 a 100).
  score         Int?
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([courseId, memberId])
  @@index([memberId], map: "idx_course_progress_member")
  @@map("course_progress")
}
