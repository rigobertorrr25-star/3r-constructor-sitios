# Copia este archivo a apps/api/.env y rellénalo. NUNCA subas el .env real a git.
# Todos los valores de abajo son de ejemplo, no reales.

# Base Postgres en la nube (ej. Neon). Usa una base o rama de DESARROLLO.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require"

# Autenticación
JWT_ACCESS_SECRET="cambia-esto"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# API y frontend
# API_PORT: solo en desarrollo. En Render (y la mayoría de hostings) el puerto llega solo en PORT,
# no hace falta ponerlo ahí.
API_PORT="3001"
# WEB_ORIGIN: de dónde puede llegar el navegador (CORS). En producción, tu dominio con https.
WEB_ORIGIN="http://localhost:3000"

# Redis: opcional por ahora, se usará más adelante para colas (BullMQ)
REDIS_URL=""

# Correos (registro, recuperar contraseña, avisos de pedidos). Sin RESEND_API_KEY, los correos
# se registran en el log de la API pero no se mandan de verdad (útil para desarrollo).
# Consigue una llave gratis en https://resend.com
RESEND_API_KEY=""
# Remitente. Sin verificar un dominio propio en Resend, solo puedes usar onboarding@resend.dev
# y (en su plan gratis) puede que solo te deje mandar a tu propio correo de la cuenta de Resend.
EMAIL_FROM="3R <onboarding@resend.dev>"
# A quién le llegan los avisos de cuentas nuevas, pedidos nuevos y mensajes de clientes.
ADMIN_EMAIL="tucorreo@ejemplo.com"

# Frontend (Next.js, lado servidor)
API_URL="http://localhost:3001/api/v1"

# Texto que ve el cliente en su pedido sobre cómo pagar (opcional; solo lo lee el servidor web)
# PAYMENT_INSTRUCTIONS="Transferencia a … o escríbenos por WhatsApp al …"

# Pago en línea con Wompi (API). Sin las dos primeras, el botón de pago no aparece.
# Panel de Wompi → Desarrolladores. Llaves de prueba: pub_test_… ; de producción: pub_prod_…
# WOMPI_PUBLIC_KEY="pub_test_…"
# WOMPI_INTEGRITY_SECRET="test_integrity_…"
# Secreto de eventos: verifica los avisos de pago. En Wompi, la URL de eventos es
# https://TU-API/api/v1/payments/wompi/events
# WOMPI_EVENTS_SECRET="test_events_…"

# Aviso de renovación del dominio propio (un mes antes de vencer). La misma clave, larga y al azar, va en la
# API (Render) y en la web (Vercel): el cron diario de Vercel (apps/web/vercel.json) llama a la web, y la web
# a la API, con "Authorization: Bearer <CRON_SECRET>". Sin ella, no se revisa nada.
# CRON_SECRET="una-clave-larga-al-azar"

# Sitios publicados de los clientes
# Dominio base: cada sitio queda en etiqueta.<SITES_ROOT_HOST> (en desarrollo, *.localhost)
SITES_ROOT_HOST="localhost"
# Cómo se escribe la dirección pública (la etiqueta reemplaza {label})
SITES_URL_TEMPLATE="http://{label}.localhost:3000"
# Carpeta donde se guardan los archivos publicados en desarrollo (por defecto: LOCALAPPDATA/3r-published).
# En producción, mejor usar Cloudflare R2 (abajo) — el disco de hostings como Render no es permanente.
# PUBLISH_DIR=""

# Cloudflare R2 para los sitios publicados y las imágenes/videos subidos en el editor (deja las
# variables vacías para usar disco local, perfecto para desarrollo).
# Panel de Cloudflare → R2 → crea un bucket y un token con permiso de lectura/escritura sobre él.
# R2_BUCKET="3r-media"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# Dirección pública del bucket (actívala en el bucket: Settings → Public access → r2.dev, o tu
# propio dominio). Sin esta, aunque pongas las 4 de arriba, las imágenes/videos usan disco local
# (los sitios publicados no la necesitan: esos siempre se sirven a través de la API).
# R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"
