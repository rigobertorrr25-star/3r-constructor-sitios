{
  "name": "website-builder",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS constructor de sitios web (monolito modular NestJS + Next.js)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w api --if-present",
    "db:migrate": "npm run db:migrate -w api --if-present",
    "db:seed": "npm run db:seed -w api --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
